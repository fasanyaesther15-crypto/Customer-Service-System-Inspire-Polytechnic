<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow">Student portal</p><h1>Live support</h1><p class="lead">Your conversation with the support team.</p></header>
  <% if (!activeSession) { %>
    <section class="empty-state student-chat-empty"><h2>No chat session yet</h2><p>Start a conversation with the support team when you need help.</p><form method="post" action="/student/chat"><button class="button button-primary" type="submit">Start chat</button></form></section>
  <% } else { %>
    <section class="chat-workspace student-chat-workspace" data-chat-session="<%= activeSession.id %>" data-current-user="<%= currentUser.id %>" data-current-user-name="<%= currentUser.fullName %>" data-session-status="<%= activeSession.status %>"><div class="chat-thread"><div class="student-chat-header"><span class="user-avatar support-avatar">IP</span><div class="student-chat-heading-copy"><strong>Inspire Polytechnic support</strong><span>Replies to this conversation appear here</span></div><span class="chat-connection-status" data-chat-connection data-state="connecting">Connecting...</span><span class="status-badge status-<%= activeSession.status.replaceAll(' ', '-') %>" data-chat-status><%= activeSession.status %></span><% if (activeSession.status !== 'closed') { %><button class="button button-quiet student-close-chat" type="button" data-close-chat>Close chat</button><% } %></div><div class="chat-messages" data-chat-messages aria-live="polite"><p class="chat-loading"><span class="loading-indicator" aria-hidden="true"></span>Loading conversation...</p></div><div class="chat-closed-notice" data-chat-closed-message <%= activeSession.status === 'closed' ? '' : 'hidden' %>><p>This conversation is closed. Start a new chat if you need further help.</p><form method="post" action="/student/chat"><button class="button button-primary" type="submit">Start a new chat</button></form></div><form class="chat-composer" data-chat-form><label class="sr-only" for="chat-message">Write a message</label><textarea id="chat-message" name="message" maxlength="10000" placeholder="Write a message..." required <%= activeSession.status === 'closed' ? 'disabled' : '' %>></textarea><button class="button button-primary" type="submit" aria-label="Send message" <%= activeSession.status === 'closed' ? 'disabled' : '' %>><span aria-hidden="true">&#8593;</span><span>Send</span></button></form><p class="chat-error" data-chat-error role="alert"></p></div></section>
  <% } %>
<%- include('../partials/app-end') %>
