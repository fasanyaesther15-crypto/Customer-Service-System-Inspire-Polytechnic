<%- include('../partials/app-start', { pageTitle }) %>
<header class="student-welcome">
  <div><p class="eyebrow">Student portal</p><h1>Welcome, <%= currentUser.fullName %></h1><p>Welcome back to your student portal. Your support requests and conversations are all in one place.</p></div>
  <a class="button button-primary" href="/student/tickets/new"><span aria-hidden="true">+</span> Create a ticket</a>
</header>
<div class="student-dashboard-content">
  <section class="student-status-grid" aria-label="Your support overview">
    <article class="student-status-item"><span>Open tickets</span><strong><%= metrics.openTickets %></strong><small>Waiting for a response or update</small></article>
    <article class="student-status-item"><span>Resolved</span><strong><%= metrics.resolvedTickets %></strong><small>Resolved or closed requests</small></article>
    <article class="student-status-item student-chat-status"><span>Live support</span><strong><%= metrics.hasActiveChat ? 'Active' : 'None' %></strong><small><%= metrics.hasActiveChat ? 'Continue your conversation' : 'Start a conversation when you need help' %></small><a href="/student/chat"><%= metrics.hasActiveChat ? 'Open chat' : 'Start a chat' %><span aria-hidden="true">&#8594;</span></a></article>
  </section>

  <section class="student-quick-actions" aria-labelledby="student-actions-title">
    <div class="student-section-heading"><div><p class="eyebrow">Get help</p><h2 id="student-actions-title">Quick actions</h2></div></div>
    <nav class="student-action-list" aria-label="Student support actions">
      <a href="/student/tickets/new"><span class="student-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span><span><strong>Create a ticket</strong><small>Send a request to the support team</small></span><span class="student-action-arrow" aria-hidden="true">&#8594;</span></a>
      <a href="/student/tickets"><span class="student-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v4a3 3 0 0 0 0 6v4H4v-4a3 3 0 0 0 0-6V5Z"></path><path d="M13 8v2M13 14v2"></path></svg></span><span><strong>View my tickets</strong><small>Check updates on your requests</small></span><span class="student-action-arrow" aria-hidden="true">&#8594;</span></a>
      <a href="/student/chat"><span class="student-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"></path><path d="M8 12h8M8 9h5"></path></svg></span><span><strong>Live support</strong><small>Talk with the support team</small></span><span class="student-action-arrow" aria-hidden="true">&#8594;</span></a>
    </nav>
  </section>

  <div class="student-dashboard-columns">
    <section class="student-panel" aria-labelledby="recent-tickets-title">
      <header class="student-panel-heading"><div><p class="eyebrow">Your requests</p><h2 id="recent-tickets-title">Recent support tickets</h2></div><a href="/student/tickets">View all <span aria-hidden="true">&#8594;</span></a></header>
      <% if (!recentTickets.length) { %>
        <div class="student-empty-state"><h3>No tickets yet</h3><p>When you need help, send a request and follow the conversation here.</p><a class="button button-primary" href="/student/tickets/new">Create your first ticket</a></div>
      <% } else { %>
        <div class="student-recent-list">
          <% recentTickets.forEach((ticket) => { %>
            <a class="student-recent-ticket" href="/student/tickets/<%= ticket.id %>"><span class="student-recent-main"><strong><%= ticket.subject %></strong><small><%= ticket.category %> · Updated <%= new Date(ticket.updated_at).toLocaleDateString() %></small></span><span class="status-badge status-<%= ticket.status.replaceAll(' ', '-') %>"><%= ticket.status %></span><span class="student-row-action">View <span aria-hidden="true">&#8594;</span></span></a>
          <% }); %>
        </div>
      <% } %>
    </section>
    <aside class="student-panel student-announcements" aria-labelledby="student-announcements-title">
      <header class="student-panel-heading"><div><p class="eyebrow">For you</p><h2 id="student-announcements-title">Announcements</h2></div><a href="/announcements">All updates <span aria-hidden="true">&#8594;</span></a></header>
      <% if (!announcements.length) { %><div class="student-empty-note"><p>No current announcements.</p><a href="/faq">Browse frequently asked questions</a></div><% } else { %>
        <div class="student-announcement-list"><% announcements.forEach((announcement) => { %><article><time datetime="<%= new Date(announcement.published_at || announcement.created_at).toISOString() %>"><%= new Date(announcement.published_at || announcement.created_at).toLocaleDateString() %></time><h3><%= announcement.title %></h3><p><%= announcement.body %></p></article><% }); %></div>
      <% } %>
    </aside>
  </div>
</div>
<%- include('../partials/app-end') %>
