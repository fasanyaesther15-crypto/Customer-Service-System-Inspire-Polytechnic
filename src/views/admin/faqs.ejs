<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Administration</p><h1>FAQ management.</h1><form method="post" action="/admin/faqs" class="ticket-form"><input name="question" placeholder="Question" required><textarea name="answer" placeholder="Answer" required></textarea><input name="category" placeholder="Category" required><input name="keywords" placeholder="Comma-separated keywords"><button class="button button-primary" type="submit">Create FAQ</button></form><div class="ticket-list"><% faqs.forEach((faq) => { %><div class="ticket-row"><span><strong><%= faq.question %></strong><small><%= faq.category %> · <%= faq.is_active ? 'active' : 'inactive' %></small></span></div><% }) %></div></main><%- include('../partials/footer') %>