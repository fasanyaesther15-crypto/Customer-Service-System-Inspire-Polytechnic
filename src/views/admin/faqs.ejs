<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow">Administration</p><h1>FAQs</h1><p class="lead">Maintain the answers available to students and visitors.</p></header>
<div class="content-management-layout">
	<section class="management-panel"><div class="panel-heading"><h2>Create FAQ</h2><p>Add a question to the knowledge base.</p></div><form method="post" action="/admin/faqs" class="admin-form"><label for="faq-question">Question</label><input id="faq-question" name="question" maxlength="10000" required><label for="faq-answer">Answer</label><textarea id="faq-answer" name="answer" maxlength="10000" required></textarea><label for="faq-category">Category</label><input id="faq-category" name="category" maxlength="100" required><label for="faq-keywords">Keywords</label><input id="faq-keywords" name="keywords" placeholder="Comma-separated keywords"><button class="button button-primary" type="submit">Create FAQ</button></form></section>
	<section class="management-panel"><div class="panel-heading"><h2>Knowledge base</h2><p><%= faqs.length %> FAQ entries</p></div><% if (!faqs.length) { %><p class="inline-empty">No FAQs have been created.</p><% } else { %><div class="managed-content-list"><% faqs.forEach((faq) => { %><details class="managed-content-item"><summary><span><strong><%= faq.question %></strong><small><%= faq.category %> · <%= faq.is_active ? 'Active' : 'Inactive' %></small></span><span class="disclosure-mark" aria-hidden="true">+</span></summary><form method="post" action="/admin/faqs/<%= faq.id %>" class="admin-form"><label for="faq-question-<%= faq.id %>">Question</label><input id="faq-question-<%= faq.id %>" name="question" value="<%= faq.question %>" required><label for="faq-answer-<%= faq.id %>">Answer</label><textarea id="faq-answer-<%= faq.id %>" name="answer" required><%= faq.answer %></textarea><label for="faq-category-<%= faq.id %>">Category</label><input id="faq-category-<%= faq.id %>" name="category" value="<%= faq.category %>" required><label for="faq-keywords-<%= faq.id %>">Keywords</label><input id="faq-keywords-<%= faq.id %>" name="keywords" value="<%= Array.isArray(faq.keywords) ? faq.keywords.join(', ') : faq.keywords || '' %>"><label for="faq-active-<%= faq.id %>">Status</label><select id="faq-active-<%= faq.id %>" name="isActive"><option value="true" <%= faq.is_active ? 'selected' : '' %>>Active</option><option value="false" <%= !faq.is_active ? 'selected' : '' %>>Inactive</option></select><button class="button button-quiet" type="submit">Save FAQ</button></form></details><% }) %></div><% } %></section>
</div>
<%- include('../partials/app-end') %>