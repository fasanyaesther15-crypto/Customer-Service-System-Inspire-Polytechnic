<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow">Administration</p><h1>Announcements</h1><p class="lead">Publish service updates and keep drafts ready for review.</p></header>
<div class="content-management-layout announcement-layout">
	<section class="management-panel"><div class="panel-heading"><h2>New announcement</h2><p>Create a notice for the public website.</p></div><form method="post" action="/admin/announcements" class="admin-form"><label for="announcement-title">Title</label><input id="announcement-title" name="title" maxlength="200" required><label for="announcement-body">Announcement</label><textarea id="announcement-body" name="body" maxlength="10000" required></textarea><label for="announcement-publish">Publication</label><select id="announcement-publish" name="isPublished"><option value="false">Save as draft</option><option value="true">Publish now</option></select><button class="button button-primary" type="submit">Save announcement</button></form></section>
	<section class="management-panel"><div class="panel-heading"><h2>Recent announcements</h2><p><%= announcements.length %> items</p></div><% if (!announcements.length) { %><p class="inline-empty">No announcements yet.</p><% } else { %><div class="managed-content-list"><% announcements.forEach((item) => { %><article class="announcement-record"><div><strong><%= item.title %></strong><span class="status-badge <%= item.is_published ? 'user-status-active' : 'user-status-inactive' %>"><%= item.is_published ? 'Published' : 'Draft' %></span></div><p><%= item.body %></p><small><%= new Date(item.created_at).toLocaleDateString() %></small></article><% }) %></div><% } %></section>
</div>
<%- include('../partials/app-end') %>