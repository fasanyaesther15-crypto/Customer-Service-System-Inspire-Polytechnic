<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Administration</p><h1>Announcements.</h1><form method="post" action="/admin/announcements" class="ticket-form"><input name="title" placeholder="Title" required><textarea name="body" placeholder="Announcement body" required></textarea><select name="isPublished"><option value="false">Draft</option><option value="true">Publish now</option></select><button class="button button-primary" type="submit">Save announcement</button></form><div class="ticket-list"><% announcements.forEach((item) => { %><div class="ticket-row"><span><strong><%= item.title %></strong><small><%= item.is_published ? 'published' : 'draft' %></small></span></div><% }) %></div></main><%- include('../partials/footer') %>