<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Administration</p><h1>Activity logs.</h1><div class="ticket-list"><% logs.forEach((log) => { %><div class="ticket-row"><span><strong><%= log.action %></strong><small><%= log.actor_name || 'System' %> · <%= new Date(log.created_at).toLocaleString() %></small></span></div><% }) %></div></main><%- include('../partials/footer') %>