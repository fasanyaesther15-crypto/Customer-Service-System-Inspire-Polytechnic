<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Administration</p><h1>Users.</h1><div class="ticket-list"><% users.forEach((user) => { %><div class="ticket-row"><span><strong><%= user.full_name %></strong><small><%= user.email %></small></span><form method="post" action="/admin/users/<%= user.id %>"><select name="role"><% ['student','support_agent','administrator'].forEach((role) => { %><option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select><label><input type="checkbox" name="isActive" value="true" <%= user.is_active ? 'checked' : '' %>> Active</label><button class="button button-quiet" type="submit">Save</button></form></div><% }) %></div></main><%- include('../partials/footer') %>