<%- include('head', { pageTitle, bodyClass: 'app-body', workspaceRole: currentUser.role }) %>
<% const role = currentUser.role; %>
<% const navGroups = role === 'administrator' ? [
  { title: 'Administration', links: [
    { label: 'Dashboard', href: '/admin/dashboard', icon: 'dashboard' },
    { label: 'Users', href: '/admin/users', icon: 'users' },
    { label: 'FAQs', href: '/admin/faqs', icon: 'faq' },
    { label: 'Announcements', href: '/admin/announcements', icon: 'announcements' },
    { label: 'Activity logs', href: '/admin/activity-logs', icon: 'activity' }
  ] },
  { title: 'Support', links: [
    { label: 'Tickets', href: '/support/tickets', icon: 'tickets' },
    { label: 'Chats', href: '/support/chats', icon: 'chat' }
  ] }
] : role === 'support_agent' ? [
  { title: 'Support', links: [
    { label: 'Dashboard', href: '/support/dashboard', icon: 'dashboard' },
    { label: 'Tickets', href: '/support/tickets', icon: 'tickets' },
    { label: 'Chats', href: '/support/chats', icon: 'chat' }
  ] }
] : [
  { title: 'Student portal', links: [
    { label: 'Dashboard', href: '/student/dashboard', icon: 'dashboard' },
    { label: 'My tickets', href: '/student/tickets', icon: 'tickets' },
    { label: 'Live support', href: '/student/chat', icon: 'chat' }
  ] }
]; %>
  <div class="workspace-shell">
    <button class="workspace-backdrop" type="button" aria-label="Close workspace navigation" data-sidebar-close></button>
    <aside class="workspace-sidebar" id="workspace-sidebar" aria-label="Workspace navigation">
      <a class="workspace-brand" href="/" aria-label="Inspire Polytechnic home">
        <span class="workspace-brand-mark"><img src="/image/422401-removebg-preview.png" alt=""></span>
        <span><strong>Inspire Polytechnic</strong><small>Customer service</small></span>
      </a>
      <button class="workspace-close" type="button" aria-label="Close navigation" data-sidebar-close>×</button>
      <nav class="workspace-nav">
        <% navGroups.forEach((group) => { %>
          <div class="workspace-nav-group">
            <p class="workspace-nav-label"><%= group.title %></p>
            <% group.links.forEach((link) => { const active = currentPath === link.href || (link.href !== '/support/dashboard' && link.href !== '/admin/dashboard' && link.href !== '/student/dashboard' && currentPath.startsWith(`${link.href}/`)); %>
              <a class="workspace-nav-link <%= active ? 'is-active' : '' %>" href="<%= link.href %>" <% if (active) { %>aria-current="page"<% } %>>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <% if (link.icon === 'dashboard') { %><rect x="3" y="3" width="8" height="8" rx="1"></rect><rect x="13" y="3" width="8" height="5" rx="1"></rect><rect x="13" y="10" width="8" height="11" rx="1"></rect><rect x="3" y="13" width="8" height="8" rx="1"></rect>
                  <% } else if (link.icon === 'users') { %><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="10" cy="7" r="4"></circle><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                  <% } else if (link.icon === 'faq') { %><circle cx="12" cy="12" r="9"></circle><path d="M9.6 9a2.5 2.5 0 1 1 4.2 1.8c-1.2 1-1.8 1.2-1.8 2.7M12 17h.01"></path>
                  <% } else if (link.icon === 'announcements') { %><path d="M4 11v2a2 2 0 0 0 2 2h2l8 4V5l-8 4H6a2 2 0 0 0-2 2Z"></path><path d="m8 15 1 5h3l-2-4M19 9a4 4 0 0 1 0 6"></path>
                  <% } else if (link.icon === 'activity') { %><path d="M3 12h4l3-8 4 16 3-8h4"></path>
                  <% } else if (link.icon === 'tickets') { %><path d="M4 5h16v4a3 3 0 0 0 0 6v4H4v-4a3 3 0 0 0 0-6V5Z"></path><path d="M13 8v2M13 14v2"></path>
                  <% } else { %><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"></path><path d="M8 12h8M8 9h5"></path><% } %>
                </svg>
                <span><%= link.label %></span>
              </a>
            <% }) %>
          </div>
        <% }) %>
      </nav>
      <div class="workspace-account">
        <span class="user-avatar"><%= currentUser.fullName.split(/\s+/).map((part) => part[0]).slice(0, 2).join('').toUpperCase() %></span>
        <span class="workspace-account-copy"><strong><%= currentUser.fullName %></strong><small><%= role === 'support_agent' ? 'Support agent' : role === 'administrator' ? 'Administrator' : 'Student' %></small></span>
        <form method="post" action="/logout"><button type="submit" class="workspace-logout" aria-label="Log out" title="Log out"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17l5-5-5-5M15 12H3"></path><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path></svg></button></form>
      </div>
    </aside>
    <div class="workspace-main">
      <header class="workspace-topbar">
        <button class="workspace-menu-toggle" type="button" aria-expanded="false" aria-controls="workspace-sidebar" aria-label="Open workspace navigation" data-sidebar-open><span></span><span></span><span></span></button>
        <div class="workspace-topbar-title"><span><%= role === 'administrator' ? 'Administration' : role === 'support_agent' ? 'Support workspace' : 'Student portal' %></span><strong><%= pageTitle %></strong></div>
        <a class="workspace-home-link" href="/" aria-label="Back to home page">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11.5 12 4l9 7.5"></path>
            <path d="M5 10.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8.5"></path>
            <path d="M9.5 20v-6h5v6"></path>
          </svg>
        </a>
      </header>
      <main class="workspace-content">