<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow">Support workspace</p><h1>Support dashboard</h1><p class="lead">Review the ticket queue and respond to student conversations.</p></header>
<section class="metric-grid metric-grid-support" aria-label="Support overview"><article class="metric-card"><span>Open tickets</span><strong><%= metrics.openTickets %></strong></article><article class="metric-card"><span>High-priority tickets</span><strong><%= metrics.urgentTickets %></strong></article><article class="metric-card"><span>Active chats</span><strong><%= metrics.activeChats %></strong></article></section>
<section class="dashboard-section"><div class="section-heading"><div><p class="eyebrow">Queue</p><h2>Recent tickets</h2></div><a class="button button-quiet" href="/support/chats">Open chat inbox</a></div><%- include('ticket-table', { tickets: tickets.slice(0, 10) }) %></section>
<%- include('../partials/app-end') %>