<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow">Support workspace</p><h1>Chats</h1><p class="lead">Student conversations, ordered by recent activity.</p></header>
<section class="conversation-inbox" aria-label="Chat conversations"><div class="inbox-heading"><h2>Conversations</h2><span><%= sessions.length %></span></div><% if (!sessions.length) { %><div class="inline-empty">No chat sessions yet.</div><% } else { %><div class="conversation-list"><% sessions.forEach((session) => { const initials = session.is_guest ? 'GV' : session.student_name.split(/\s+/).map((part) => part[0]).slice(0, 2).join('').toUpperCase(); %><article class="conversation-item"><a href="/support/chats/<%= session.id %>" class="conversation-link"><span class="user-avatar"><%= initials %></span><span class="conversation-copy"><strong><%= session.is_guest ? 'Guest visitor' : session.student_name %></strong><small><%= session.is_guest ? `${session.guest_name}${session.guest_email ? ` · ${session.guest_email}` : ''}` : session.last_message || (session.agent_name ? `Assigned to ${session.agent_name}` : 'Awaiting assignment') %></small><% if (session.is_guest) { %><small><%= session.last_message || 'New guest conversation' %></small><% } %></span><span class="status-badge status-<%= session.status.replaceAll(' ', '-') %>"><%= session.status %></span><time datetime="<%= new Date(session.updated_at).toISOString() %>"><%= new Date(session.updated_at).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %></time></a><% if (session.status !== 'closed' && session.assigned_agent_id !== currentUser.id) { %><form method="post" action="/support/chats/<%= session.id %>/assign"><button class="button button-quiet" type="submit">Assign to me</button></form><% } %></article><% }) %></div><% } %></section>
<%- include('../partials/app-end') %>