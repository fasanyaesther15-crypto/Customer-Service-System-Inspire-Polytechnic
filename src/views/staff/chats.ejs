<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Support workspace</p><h1>Chat monitoring.</h1><div class="ticket-list"><% if (!sessions.length) { %><div class="empty-state"><h2>No chat sessions.</h2></div><% } %><% sessions.forEach((session) => { %><div class="ticket-row"><span><strong><%= session.student_name %></strong><small><%= session.status %> · <%= new Date(session.updated_at).toLocaleString() %></small></span><% if (session.status !== 'closed') { %><form method="post" action="/support/chats/<%= session.id %>/assign"><button class="button button-primary" type="submit">Assign to me</button></form><% } %></div><% }) %></div></main><%- include('../partials/footer') %>