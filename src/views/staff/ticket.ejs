<%- include('../partials/head', { pageTitle }) %><%- include('../partials/navigation') %><main class="page-shell portal-page"><p class="eyebrow">Support ticket</p><h1><%= ticket.subject %></h1><p class="lead"><%= ticket.student_name %> · <%= ticket.category %></p><form method="post" action="/support/tickets/<%= ticket.id %>/assign"><button class="button button-quiet" type="submit">Assign to me</button></form><div class="message-list"><% messages.forEach((message) => { %><article class="message-item"><div class="message-meta"><strong><%= message.sender_name %></strong><span><%= new Date(message.created_at).toLocaleString() %></span></div><p><%= message.message %></p></article><% }) %></div><form method="post" action="/support/tickets/<%= ticket.id %>/status" class="ticket-form"><label for="status">Status</label><select id="status" name="status"><% statuses.forEach((status) => { %><option <%= ticket.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="button button-primary" type="submit">Update status</button></form><form method="post" action="/support/tickets/<%= ticket.id %>/messages" class="ticket-form"><label for="message">Response</label><textarea id="message" name="message" required></textarea><button class="button button-primary" type="submit">Send response</button></form></main><%- include('../partials/footer') %>