<%- include('../partials/app-start', { pageTitle }) %>
<header class="app-page-header"><p class="eyebrow"><a href="/support/tickets">Tickets</a> / Ticket details</p><div class="ticket-header"><div><h1><%= ticket.subject %></h1><p class="lead"><%= ticket.student_name %> · <%= ticket.category %> · <span class="priority-badge priority-<%= ticket.priority %>"><%= ticket.priority %> priority</span></p></div><span class="status-badge status-<%= ticket.status.replaceAll(' ', '-') %>"><%= ticket.status %></span></div></header>
<div class="ticket-workspace"><section class="ticket-conversation"><div class="section-heading"><div><p class="eyebrow">Conversation</p><h2>Student request</h2></div></div><div class="message-list"><% messages.forEach((message) => { %><article class="message-item"><div class="message-meta"><strong><%= message.sender_name %></strong><time datetime="<%= new Date(message.created_at).toISOString() %>"><%= new Date(message.created_at).toLocaleString() %></time></div><p><%= message.message %></p></article><% }) %></div><form method="post" action="/support/tickets/<%= ticket.id %>/messages" class="admin-form message-form"><label for="message">Reply to student</label><textarea id="message" name="message" maxlength="10000" required></textarea><button class="button button-primary" type="submit">Send response</button></form></section><aside class="ticket-facts"><p class="eyebrow">Ticket details</p><dl><dt>Status</dt><dd><%= ticket.status %></dd><dt>Priority</dt><dd><%= ticket.priority %></dd><dt>Category</dt><dd><%= ticket.category %></dd><dt>Assigned agent</dt><dd><%= ticket.agent_name || 'Unassigned' %></dd><dt>Last updated</dt><dd><%= new Date(ticket.updated_at).toLocaleDateString() %></dd></dl><form method="post" action="/support/tickets/<%= ticket.id %>/assign" class="admin-form"><button class="button button-quiet" type="submit">Assign to me</button></form><form method="post" action="/support/tickets/<%= ticket.id %>/status" class="admin-form"><label for="status">Update status</label><select id="status" name="status"><% statuses.forEach((status) => { %><option value="<%= status %>" <%= ticket.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="button button-quiet" type="submit">Update status</button></form></aside></div>
<%- include('../partials/app-end') %>