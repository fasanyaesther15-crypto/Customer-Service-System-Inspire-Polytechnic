<div class="ticket-list"><% if (!tickets.length) { %><div class="empty-state"><h2>No tickets.</h2></div><% } %><% tickets.forEach((ticket) => { %><a class="ticket-row" href="/support/tickets/<%= ticket.id %>"><span><strong><%= ticket.subject %></strong><small><%= ticket.student_name %> · <%= ticket.category %></small></span><span class="status-badge status-<%= ticket.status.replaceAll(' ', '-') %>"><%= ticket.status %></span></a><% }) %></div>