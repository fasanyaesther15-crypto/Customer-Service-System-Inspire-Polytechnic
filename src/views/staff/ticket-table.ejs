<% if (!tickets.length) { %><div class="inline-empty">No tickets in the queue.</div><% } else { %><div class="support-ticket-list" role="list"><% tickets.forEach((ticket) => { %><a class="support-ticket-row" role="listitem" href="/support/tickets/<%= ticket.id %>"><span class="ticket-main"><strong><%= ticket.subject %></strong><small><%= ticket.student_name %> · <%= ticket.category %></small></span><span class="priority-badge priority-<%= ticket.priority %>"><%= ticket.priority %></span><span class="status-badge status-<%= ticket.status.replaceAll(' ', '-') %>"><%= ticket.status %></span><time datetime="<%= new Date(ticket.updated_at).toISOString() %>"><%= new Date(ticket.updated_at).toLocaleDateString() %></time></a><% }) %></div><% } %>