<%- include('partials/head', { pageTitle }) %>
<%- include('partials/navigation') %>
<main class="page-shell public-page">
  <header class="page-intro">
    <p class="eyebrow">Courses</p>
    <h1>Programmes at Inspire Polytechnic.</h1>
    <p class="lead">Explore National Diploma and vocational course options. Contact Inspire Polytechnic for current course information and admissions guidance.</p>
  </header>
  <% programmeGroups.forEach((group, groupIndex) => { %>
    <section class="programme-directory-group" id="programme-group-<%= groupIndex + 1 %>">
      <header class="programme-directory-heading"><p class="eyebrow"><%= group.category %></p><h2><%= group.programmes.length %> course options</h2></header>
      <div class="programme-directory-grid"><% group.programmes.forEach((programme) => { %><article class="programme-directory-item"><span class="programme-category"><%= group.category %></span><h3><%= programme %></h3><a href="/contact">Ask about this course <span aria-hidden="true">&#8594;</span></a></article><% }); %></div>
    </section>
  <% }); %>
  <section class="programme-help-band"><div><p class="eyebrow">Admissions guidance</p><h2>Need help choosing a course?</h2></div><a class="button button-primary" href="/contact">Contact admissions</a></section>
</main>
<%- include('partials/footer') %>
