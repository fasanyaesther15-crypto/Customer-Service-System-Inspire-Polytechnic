<%- include('partials/head', { pageTitle: 'Home' }) %>

<div class="accent-bar"></div>

<header class="site-header home-header">
  <div class="brand" aria-label="Inspire Polytechnic home">
    <a href="/" class="brand-mark">IP</a>
    <div class="brand-name">Inspire Polytechnic</div>
  </div>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open navigation">
    Menu
  </button>

  <nav id="site-navigation" class="site-navigation home-nav" aria-label="Primary navigation">
    <a class="active" href="/">Home</a>
    <a href="/about">About</a>
    <a href="/programmes">Programmes</a>
    <a href="/admissions">Admissions</a>
    <a href="/faq">FAQ</a>
    <a href="/login" class="nav-login">Login</a>
    <a href="/register" class="btn-register">Register</a>
  </nav>
</header>

<section class="hero">
  <div class="section-inner hero-inner">
    <div class="hero-copy">
      <div class="eyebrow">Welcome to Inspire Polytechnic</div>
      <p class="sr-only">Support that keeps student questions moving.</p>
      <h1>Learning, support and student services in one place.</h1>
      <p>Explore institutional information, get instant answers to common questions, or connect with the customer support team.</p>
      <div class="hero-actions">
        <a href="/programmes" class="btn btn-primary">Explore Programmes</a>
        <a href="/contact" class="btn btn-secondary">Get Support</a>
      </div>
    </div>

    <div class="info-card">
      <a href="/faq" class="info-item">
        <div class="big">24/7</div>
        <div class="small">FAQ assistance</div>
      </a>
      <a href="/student/chat" class="info-item">
        <div class="big">Live</div>
        <div class="small">support chat</div>
      </a>
      <a href="/student/tickets" class="info-item">
        <div class="big">Track</div>
        <div class="small">support tickets</div>
      </a>
    </div>
  </div>
</section>

<section class="about" id="about">
  <div class="section-inner about-grid">
    <div class="about-copy">
      <div class="eyebrow">About us</div>
      <h2>Built around every student's journey</h2>
      <p>Inspire Polytechnic brings admissions, academics and support together in one place, so students spend less time chasing answers and more time learning.</p>
      <p>Our customer service team and self-serve tools work side by side, giving you a fast answer whether you prefer to search, chat, or speak with someone directly.</p>
    </div>
    <div class="stat-grid">
      <div class="stat-card"><div class="num">12,400+</div><div class="label">Students supported</div></div>
      <div class="stat-card"><div class="num">18</div><div class="label">Programmes offered</div></div>
      <div class="stat-card"><div class="num">9</div><div class="label">Years of service</div></div>
    </div>
  </div>
</section>

<section class="programmes" id="programmes">
  <div class="section-inner">
    <div class="section-head">
      <div class="eyebrow">Programmes</div>
      <h2>Find the right path for you</h2>
      <p>Explore our most requested programmes across technology, business and the sciences.</p>
    </div>
    <div class="programme-grid">
      <div class="programme-card">
        <div class="programme-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" aria-label="Computer Science icon">
            <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H13l-2 4h2v1H7v-1h2l-2-4H6.5A2.5 2.5 0 0 1 4 13.5zm2.5-.5h11a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z"/>
          </svg>
        </div>
        <h3>Computer Science</h3>
        <p>Software development, systems and networking foundations for the tech industry.</p>
        <a href="#">Learn more</a>
      </div>
      <div class="programme-card">
        <div class="programme-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" aria-label="Business Administration icon">
            <path d="M3 8.5 12 4l9 4.5-9 4.5L3 8.5zm4 1.7v4.8L12 17l5-2v-4.8L12 14l-5-3.8zm-1.5 5.8h13v1.5h-13z"/>
          </svg>
        </div>
        <h3>Business Administration</h3>
        <p>Management, finance and entrepreneurship skills for future business leaders.</p>
        <a href="#">Learn more</a>
      </div>
      <div class="programme-card">
        <div class="programme-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" aria-label="Engineering Technology icon">
            <path d="M12 2v4.5M9.5 5.5l5 13M4.5 11.5l4.5-1.5 1.5 4.5-4.5 1.5-1.5-4.5zm14.5 0l-4.5-1.5-1.5 4.5 4.5 1.5 1.5-4.5zM12 16v6"/>
          </svg>
        </div>
        <h3>Engineering Technology</h3>
        <p>Hands-on training across mechanical, electrical and civil disciplines.</p>
        <a href="#">Learn more</a>
      </div>
      <div class="programme-card">
        <div class="programme-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" aria-label="Mass Communication icon">
            <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h11A2.5 2.5 0 0 1 19 7.5v6A2.5 2.5 0 0 1 16.5 16H9l-5 4v-4.5A2.5 2.5 0 0 1 3 13.5zm3.5-1.5h8v2h-8zm0 4h6v2h-6zm-2 5h11v1.5H4.5z"/>
          </svg>
        </div>
        <h3>Mass Communication</h3>
        <p>Media production, journalism and public relations for the modern communicator.</p>
        <a href="#">Learn more</a>
      </div>
    </div>
  </div>
</section>

<section id="admissions">
  <div class="section-inner">
    <div class="cta-banner">
      <div>
        <h2>Ready to begin your admission?</h2>
        <p>Start your application today or chat with our support team if you have questions along the way.</p>
      </div>
      <a href="/admissions" class="btn btn-secondary">Start Application</a>
    </div>
  </div>
</section>

<section class="faq" id="faq">
  <div class="section-inner">
    <div class="section-head">
      <div class="eyebrow">FAQ</div>
      <h2>Common questions</h2>
      <p>Can't find what you're looking for? Our support team is available around the clock.</p>
    </div>
    <div class="faq-list">
      <details class="faq-item" open>
        <summary>How do I apply for admission?</summary>
        <p>Click "Start Application" above, create an account, and follow the guided steps to submit your documents online.</p>
      </details>
      <details class="faq-item">
        <summary>What programmes are currently open for enrollment?</summary>
        <p>All programmes listed above are open for the current academic session. Visit the Programmes page for full details and requirements.</p>
      </details>
      <details class="faq-item">
        <summary>How can I reach customer support?</summary>
        <p>Use the Live Chat button on any page, raise a support ticket, or reach us through the contact details in the footer.</p>
      </details>
      <details class="faq-item">
        <summary>Can I track the status of my support ticket?</summary>
        <p>Yes. Once logged in, your ticket history and live status are available from your student dashboard.</p>
      </details>
    </div>
  </div>
</section>

<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <div class="brand-mark">IP</div>
        <div class="brand-name">Inspire Polytechnic</div>
      </div>
      <p>Learning, support and student services, brought together in one place.</p>
    </div>
    <div class="footer-col">
      <h4>Institution</h4>
      <a href="/about">About</a>
      <a href="/programmes">Programmes</a>
      <a href="/admissions">Admissions</a>
    </div>
    <div class="footer-col">
      <h4>Support</h4>
      <a href="/faq">FAQ</a>
      <a href="/student/chat">Live Chat</a>
      <a href="/student/tickets">Track Ticket</a>
    </div>
    <div class="footer-col">
      <h4>Account</h4>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
    </div>
  </div>
  <div class="footer-bottom">&copy; 2026 Inspire Polytechnic. All rights reserved.</div>
</footer>
