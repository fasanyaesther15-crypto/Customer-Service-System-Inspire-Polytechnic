<%- include('partials/head', { pageTitle }) %>
<%- include('partials/navigation') %>
<main>
  <section class="hero-band">
    <div class="page-shell hero-grid">
      <div class="hero-copy-wrap">
        <p class="eyebrow">Inspire Polytechnic</p>
        <h1>Support that keeps student questions moving.</h1>
        <p class="hero-copy">Find information about programmes and admissions, browse common questions, or get help from the support team when you need a faster answer.</p>
        <div class="button-row">
          <a class="button button-primary" href="/programmes">Explore programmes</a>
          <a class="button button-secondary" href="/contact">Contact support</a>
        </div>
      </div>
      <div class="hero-note" aria-label="Customer service pathways">
        <div class="panel-header">
          <p class="eyebrow">Student support</p>
        </div>
        <ul class="pathway-list">
          <li>
            <a href="/faq">
              <span class="feature-pill">24/7</span>
              <div>
                <strong>FAQ assistance</strong>
                <small>Search the student knowledge base</small>
              </div>
            </a>
          </li>
          <li>
            <a href="/student/chat">
              <span class="feature-pill">Live</span>
              <div>
                <strong>Support chat</strong>
                <small>Speak with an authorized support agent</small>
              </div>
            </a>
          </li>
          <li>
            <a href="/student/tickets">
              <span class="feature-pill">Track</span>
              <div>
                <strong>Support tickets</strong>
                <small>Review progress and follow up quickly</small>
              </div>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
  <section class="page-shell section-block">
    <div class="section-heading">
      <p class="eyebrow">A clear first step</p>
      <h2>Useful information, without the runaround.</h2>
    </div>
    <div class="feature-grid">
      <a class="feature-card" href="/programmes"><span class="card-number">01</span><h3>Programmes</h3><p>Review the programme information area and find the right next question to ask.</p></a>
      <a class="feature-card" href="/admissions"><span class="card-number">02</span><h3>Admissions</h3><p>Follow the admissions information pathway and contact support when you need clarification.</p></a>
      <a class="feature-card" href="/faq"><span class="card-number">03</span><h3>FAQ</h3><p>Browse the current knowledge base for answers to common student questions.</p></a>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
